{
  "name": "chess-open-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w apps/mobile",
    "web": "npm run web -w apps/mobile",
    "android": "npm run android -w apps/mobile",
    "test": "jest",
    "typecheck": "tsc -b packages/core packages/ui tools/pipeline && npm run typecheck -w apps/mobile",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:build": "tsx tools/pipeline/build-pack.ts",
    "pack:check": "tsx tools/pipeline/build-pack.ts --all --check",
    "pack:schema": "tsx tools/pipeline/build-pack.ts schema",
    "pack:explorer": "tsx tools/pipeline/build-explorer.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "license": "GPL-3.0-or-later"
}
